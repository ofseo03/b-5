# 서버 포트
PORT=4000

# LLM 제공자: mock(기본, API 키 불필요) | anthropic
LLM_PROVIDER=mock

# LLM_PROVIDER=anthropic 일 때 필요 (또는 `ant auth login` 프로필)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# 선택 보류 시간(분)과 마감 전 알림 시점(분). 시연할 때는 3 / 1 처럼 줄여서 확인
DECISION_WINDOW_MINUTES=1440
REMINDER_BEFORE_MINUTES=60

# 페르소나와 주고받을 수 있는 대화 횟수
PERSONA_TURN_LIMIT=5

# 페르소나 채팅방 최대 개수 (0 = 제한 없음, 회의에서 5 또는 10 거론, 미정)
MAX_PERSONA_ROOMS=0
